# Database
DATABASE_URL=postgresql+asyncpg://youruser:yourpassword@localhost:5432/linkedin_ai_advisor
SECRET_KEY=your-secret-key-here


# Mail (Mailtrap for development — https://mailtrap.io)
# 1. Create a free account at mailtrap.io
# 2. Go to Email Testing → Inboxes → your inbox → SMTP Settings
# 3. Select "Django" or "Python" from the integrations dropdown
# 4. Copy the credentials below
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=3LM@example.com
MAIL_USE_TLS=true

# Frontend
FRONTEND_URL=http://localhost:8000

# AI service (Java/Spring module in ai-service/)
AI_SERVICE_URL=http://localhost:8080

# Mistral API key for the AI module
MISTRAL_API_KEY=your-mistral-api-key